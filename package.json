{
  "name": "@quantovainc/qbiometric",
  "version": "0.1.0",
  "description": "Quantum secure biometric enrolment and match attestation records. Proves the enrolment, match, re enrolment, lock and erasure of a biometric reference, with ML-DSA-65 under FIPS 204 and Quantova time proofs. Only a one way digest of a template is ever referenced, never the biometric itself, which never leaves the party that holds it.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "wasm/qbiometric_native.js",
    "wasm/qbiometric_native_bg.wasm",
    "wasm/qbiometric_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.14"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "biometric",
    "identity",
    "privacy",
    "match-attestation",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QBiometric",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QBiometric.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QBiometric/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0"
  }
}
